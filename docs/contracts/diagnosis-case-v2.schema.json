{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sqllens/contracts/diagnosis-case-v2.schema.json",
  "title": "DiagnosisCaseV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "revision",
    "inputMode",
    "workflowState",
    "outcome",
    "effectiveMode",
    "evidenceLevel",
    "sourceSnapshots",
    "evidence",
    "facts",
    "ruleFindings",
    "aiSynthesis",
    "actions",
    "uncertainty",
    "pinnedRevisions",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "diagnosis-case/v2" },
    "caseId": { "type": "string", "pattern": "^case_[a-z0-9]{16,64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "inputMode": { "enum": ["managed_source", "plan_replayer", "manual"] },
    "workflowState": {
      "enum": ["queued", "collecting", "analyzing", "ready", "failed", "cancelled"]
    },
    "outcome": {
      "enum": ["pending", "validated_effective", "rolled_back", "evidence_insufficient", "risk_accepted"]
    },
    "effectiveMode": { "enum": ["rules", "rules_ai"] },
    "evidenceLevel": { "enum": ["E0", "E1", "E2", "E3", "E4"] },
    "sourceSnapshots": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/sourceSnapshot" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "facts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/fact" }
    },
    "ruleFindings": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/ruleFinding" }
    },
    "aiSynthesis": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/aiSynthesis" }
      ]
    },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/action" }
    },
    "uncertainty": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/uncertainty" }
    },
    "pinnedRevisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulePack",
        "documentPack",
        "parser",
        "policy",
        "redaction",
        "provider",
        "model",
        "prompt"
      ],
      "properties": {
        "rulePack": { "type": "string", "minLength": 1, "maxLength": 128 },
        "documentPack": { "type": "string", "minLength": 1, "maxLength": 128 },
        "parser": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "redaction": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "type": ["string", "null"], "maxLength": 128 },
        "model": { "type": ["string", "null"], "maxLength": 256 },
        "prompt": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "revision", "type", "product", "versionFamily"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^src_[a-z0-9]{16,64}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["tidb", "prometheus", "tem", "alertmanager", "upload", "manual"] },
        "product": { "type": "string", "minLength": 1, "maxLength": 64 },
        "versionFamily": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "kind",
        "sourceId",
        "observedAt",
        "collectedAt",
        "freshness",
        "coverage",
        "sensitivity",
        "integrityDigest",
        "summaryZh"
      ],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" },
        "kind": {
          "enum": [
            "sql_structure",
            "statement_summary",
            "slow_query",
            "schema",
            "index",
            "statistics",
            "ordinary_plan",
            "runtime_metric",
            "alert",
            "validation_result"
          ]
        },
        "sourceId": {
          "type": ["string", "null"],
          "pattern": "^src_[a-z0-9]{16,64}$"
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "collectedAt": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "sensitivity": { "enum": ["public", "metadata", "confidential"] },
        "integrityDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "summaryZh": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "kind", "statementZh", "valueText", "evidenceIds"],
      "properties": {
        "factId": { "type": "string", "pattern": "^fact_[a-z0-9]{16,64}$" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "statementZh": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "valueText": { "type": ["string", "null"], "maxLength": 512 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" }
        }
      }
    },
    "ruleFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "status",
        "severity",
        "minimumEvidenceLevel",
        "conclusionZh",
        "evidenceIds",
        "documentRefs"
      ],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" },
        "status": { "enum": ["hit", "conflicted", "not_applicable"] },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "minimumEvidenceLevel": { "enum": ["E0", "E1", "E2", "E3", "E4"] },
        "conclusionZh": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" }
        },
        "documentRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "aiClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "audience", "textZh", "evidenceIds", "ruleIds"],
      "properties": {
        "claimId": { "type": "string", "pattern": "^claim_[a-z0-9]{16,64}$" },
        "audience": { "enum": ["all", "dba_sre", "developer", "incident_owner"] },
        "textZh": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" }
        },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" }
        }
      }
    },
    "aiSynthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "claims"],
      "properties": {
        "status": { "enum": ["applied", "degraded", "not_requested"] },
        "code": { "type": ["string", "null"], "maxLength": 128 },
        "claims": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/aiClaim" }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "family",
        "titleZh",
        "rationaleZh",
        "risk",
        "ownerRole",
        "prerequisitesZh",
        "stepsZh",
        "validation",
        "rollbackZh",
        "evidenceIds",
        "ruleIds",
        "requiresHumanApproval"
      ],
      "properties": {
        "actionId": { "type": "string", "pattern": "^act_[a-z0-9]{16,64}$" },
        "family": {
          "enum": [
            "sql_rewrite",
            "index_candidate",
            "statistics_refresh",
            "plan_binding_candidate",
            "evidence_collection",
            "resource_investigation"
          ]
        },
        "titleZh": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rationaleZh": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "ownerRole": { "enum": ["dba", "sre", "developer", "incident_owner"] },
        "prerequisitesZh": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "stepsZh": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metricZh", "targetZh"],
          "properties": {
            "metricZh": { "type": "string", "minLength": 1, "maxLength": 512 },
            "targetZh": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        "rollbackZh": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" }
        },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" }
        },
        "requiresHumanApproval": { "const": true }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "descriptionZh", "requiredEvidenceKinds"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "descriptionZh": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "requiredEvidenceKinds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
