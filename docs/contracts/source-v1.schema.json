{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sqllens/contracts/source-v1.schema.json",
  "title": "SourceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sourceId", "revision", "type", "name", "state",
    "product", "version", "endpoint", "auth", "credentialLifecycle", "activeLeases",
    "associatedSourceIds", "allowedSchemas", "capabilities", "budgets",
    "owner", "verification", "transitionEvents", "leaseEvents", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "source/v1" },
    "sourceId": { "type": "string", "pattern": "^src_[a-z0-9]{16,64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["tidb", "prometheus", "tem", "alertmanager"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "state": { "enum": ["draft", "enabled", "disabled", "draining", "verification_failed", "tombstoned"] },
    "product": { "enum": ["tidb", "pingkaidb", "prometheus", "tem", "alertmanager"] },
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["detected", "family", "supported"],
      "properties": {
        "detected": { "type": ["string", "null"], "maxLength": 128 },
        "family": { "enum": ["tidb-8.5", "pingkaidb-7.1", "prometheus", "tem", "alertmanager", "unknown"] },
        "supported": { "type": "boolean" }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "host", "port", "path", "tlsMode"],
      "properties": {
        "scheme": { "enum": ["mysql", "http", "https"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": ["string", "null"], "maxLength": 1024 },
        "tlsMode": { "enum": ["verify_identity", "verify_ca", "disabled"] }
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "credentialRef", "credentialRevision", "username", "expiresAt"],
      "properties": {
        "kind": { "enum": ["password", "none", "basic", "bearer", "api_key", "mtls"] },
        "credentialRef": { "type": ["string", "null"], "pattern": "^cred_[a-z0-9]{16,64}$" },
        "credentialRevision": { "type": ["integer", "null"], "minimum": 1 },
        "username": { "type": ["string", "null"], "maxLength": 256 },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "credentialLifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "activeLeaseCount", "pendingOperation", "retireAfter"],
      "properties": {
        "state": { "enum": ["none", "active", "rotating", "retiring", "tombstoned"] },
        "activeLeaseCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "pendingOperation": { "type": ["string", "null"], "enum": [null, "rotate", "disable", "delete", "verification_failure"] },
        "retireAfter": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "activeLeases": {
      "type": "array", "maxItems": 1024,
      "items": { "$ref": "#/$defs/activeLease" }
    },
    "associatedSourceIds": {
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": { "type": "string", "pattern": "^src_[a-z0-9]{16,64}$" }
    },
    "allowedSchemas": {
      "type": "array", "uniqueItems": true, "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "capabilities": {
      "type": "array", "maxItems": 64,
      "items": { "$ref": "#/$defs/capability" }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["timeoutMs", "maxRows", "maxConcurrency", "ratePerMinute"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "ratePerMinute": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["displayName", "reference"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "testedAt", "identityDigest", "errorCode"],
      "properties": {
        "status": { "enum": ["not_run", "passed", "failed"] },
        "testedAt": { "type": ["string", "null"], "format": "date-time" },
        "identityDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "errorCode": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "transitionEvents": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": { "$ref": "#/$defs/sourceTransitionEvent" }
    },
    "leaseEvents": {
      "type": "array", "maxItems": 4096,
      "items": { "$ref": "#/$defs/leaseEvent" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "tidb" } }, "required": ["type"] },
      "then": {
        "properties": {
          "product": { "enum": ["tidb", "pingkaidb"] },
          "version": { "properties": { "family": { "enum": ["tidb-8.5", "pingkaidb-7.1", "unknown"] } } },
          "endpoint": { "properties": { "scheme": { "const": "mysql" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "prometheus" } }, "required": ["type"] },
      "then": {
        "properties": {
          "product": { "const": "prometheus" },
          "version": { "properties": { "family": { "enum": ["prometheus", "unknown"] } } },
          "endpoint": { "properties": { "scheme": { "enum": ["http", "https"] } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tem" } }, "required": ["type"] },
      "then": {
        "properties": {
          "product": { "const": "tem" },
          "version": { "properties": { "family": { "enum": ["tem", "unknown"] } } },
          "endpoint": { "properties": { "scheme": { "const": "https" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "alertmanager" } }, "required": ["type"] },
      "then": {
        "properties": {
          "product": { "const": "alertmanager" },
          "version": { "properties": { "family": { "enum": ["alertmanager", "unknown"] } } },
          "endpoint": { "properties": { "scheme": { "enum": ["http", "https"] } } }
        }
      }
    },
    {
      "if": { "properties": { "product": { "const": "tidb" } }, "required": ["product"] },
      "then": {
        "properties": {
          "type": { "const": "tidb" },
          "version": { "properties": { "family": { "enum": ["tidb-8.5", "unknown"] } } }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] },
            "then": {
              "properties": {
                "auth": { "properties": { "kind": { "const": "none" } } }
              }
            },
            "else": {
              "properties": {
                "auth": { "properties": { "kind": { "const": "password" } } }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "product": { "const": "pingkaidb" } }, "required": ["product"] },
      "then": {
        "properties": {
          "type": { "const": "tidb" },
          "version": { "properties": { "family": { "enum": ["pingkaidb-7.1", "unknown"] } } }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] },
            "then": {
              "properties": {
                "auth": { "properties": { "kind": { "const": "none" } } }
              }
            },
            "else": {
              "properties": {
                "auth": { "properties": { "kind": { "const": "password" } } }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "product": { "const": "prometheus" } }, "required": ["product"] },
      "then": {
        "properties": {
          "type": { "const": "prometheus" },
          "version": { "properties": { "family": { "enum": ["prometheus", "unknown"] } } },
          "auth": { "properties": { "kind": { "enum": ["none", "basic", "bearer", "mtls"] } } }
        }
      }
    },
    {
      "if": { "properties": { "product": { "const": "tem" } }, "required": ["product"] },
      "then": {
        "properties": {
          "type": { "const": "tem" },
          "version": { "properties": { "family": { "enum": ["tem", "unknown"] } } },
          "auth": { "properties": { "kind": { "enum": ["api_key", "bearer", "mtls", "none"] } } }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] },
            "then": { "properties": { "auth": { "properties": { "kind": { "const": "none" } } } } },
            "else": { "properties": { "auth": { "properties": { "kind": { "enum": ["api_key", "bearer", "mtls"] } } } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "product": { "const": "alertmanager" } }, "required": ["product"] },
      "then": {
        "properties": {
          "type": { "const": "alertmanager" },
          "version": { "properties": { "family": { "enum": ["alertmanager", "unknown"] } } },
          "auth": { "properties": { "kind": { "enum": ["none", "basic", "bearer", "mtls"] } } }
        }
      }
    },
    {
      "if": { "properties": { "auth": { "properties": { "kind": { "const": "none" } }, "required": ["kind"] } }, "required": ["auth"] },
      "then": {
        "properties": {
          "auth": { "properties": { "credentialRef": { "type": "null" }, "credentialRevision": { "type": "null" }, "username": { "type": "null" } } },
          "credentialLifecycle": { "properties": { "state": { "enum": ["none", "retiring", "tombstoned"] } } }
        }
      },
      "else": {
        "properties": {
          "auth": { "properties": { "credentialRef": { "type": "string", "pattern": "^cred_[a-z0-9]{16,64}$" }, "credentialRevision": { "type": "integer", "minimum": 1 } } },
          "credentialLifecycle": { "properties": { "state": { "enum": ["active", "rotating", "retiring"] } } }
        }
      }
    },
    {
      "if": { "properties": { "auth": { "properties": { "kind": { "enum": ["password", "basic"] } }, "required": ["kind"] } }, "required": ["auth"] },
      "then": { "properties": { "auth": { "properties": { "username": { "type": "string", "minLength": 1, "maxLength": 256 } } } } }
    },
    {
      "if": { "properties": { "state": { "const": "enabled" } }, "required": ["state"] },
      "then": {
        "properties": {
          "version": { "properties": { "supported": { "const": true }, "family": { "not": { "const": "unknown" } }, "detected": { "type": "string", "minLength": 1 } } },
          "verification": { "properties": { "status": { "const": "passed" }, "testedAt": { "type": "string" }, "identityDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "errorCode": { "type": "null" } } },
          "credentialLifecycle": { "properties": { "state": { "enum": ["active", "none"] }, "pendingOperation": { "type": "null" } } },
          "capabilities": { "not": { "contains": { "properties": { "required": { "const": true }, "status": { "not": { "const": "available" } } }, "required": ["required", "status"] } } }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "draining" } }, "required": ["state"] },
      "then": {
        "properties": {
          "credentialLifecycle": { "properties": { "state": { "enum": ["active", "rotating", "retiring"] }, "pendingOperation": { "enum": ["rotate", "disable", "delete", "verification_failure"] } } }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["draft", "disabled", "verification_failed"] } }, "required": ["state"] },
      "then": {
        "properties": {
          "activeLeases": {
            "not": {
              "contains": {
                "properties": { "purpose": { "const": "diagnosis" } },
                "required": ["purpose"]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] },
      "then": {
        "properties": {
          "version": { "properties": { "detected": { "type": "null" }, "family": { "const": "unknown" }, "supported": { "const": false } } },
          "endpoint": { "properties": { "host": { "const": "deleted.invalid" }, "path": { "type": "null" } } },
          "auth": { "properties": { "kind": { "const": "none" }, "credentialRef": { "type": "null" }, "credentialRevision": { "type": "null" }, "username": { "type": "null" }, "expiresAt": { "type": "null" } } },
          "credentialLifecycle": { "properties": { "state": { "const": "tombstoned" }, "activeLeaseCount": { "const": 0 }, "pendingOperation": { "type": "null" }, "retireAfter": { "type": "null" } } },
          "associatedSourceIds": { "maxItems": 0 },
          "allowedSchemas": { "maxItems": 0 },
          "capabilities": { "maxItems": 0 },
          "verification": { "properties": { "status": { "const": "not_run" }, "testedAt": { "type": "null" }, "identityDigest": { "type": "null" }, "errorCode": { "type": "null" } } },
          "activeLeases": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "verification_failed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": { "const": "failed" },
              "testedAt": { "type": "string" },
              "identityDigest": { "type": "null" },
              "errorCode": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "verification": { "properties": { "status": { "const": "failed" } }, "required": ["status"] } }, "required": ["verification"] },
      "then": { "properties": { "state": { "enum": ["draining", "verification_failed"] } } }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] } }, "required": ["credentialLifecycle"] },
      "then": { "properties": { "state": { "const": "tombstoned" } } }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "state": { "enum": ["rotating", "retiring"] } }, "required": ["state"] } }, "required": ["credentialLifecycle"] },
      "then": {
        "properties": {
          "state": { "const": "draining" },
          "credentialLifecycle": { "properties": { "retireAfter": { "type": "string" } } }
        }
      }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "pendingOperation": { "type": "string" } }, "required": ["pendingOperation"] } }, "required": ["credentialLifecycle"] },
      "then": { "properties": { "state": { "const": "draining" } } }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "pendingOperation": { "const": "rotate" } }, "required": ["pendingOperation"] } }, "required": ["credentialLifecycle"] },
      "then": { "properties": { "credentialLifecycle": { "properties": { "state": { "const": "rotating" } } } } }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "pendingOperation": { "enum": ["disable", "delete"] } }, "required": ["pendingOperation"] } }, "required": ["credentialLifecycle"] },
      "then": { "properties": { "credentialLifecycle": { "properties": { "state": { "const": "retiring" } } } } }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "pendingOperation": { "const": "verification_failure" } }, "required": ["pendingOperation"] } }, "required": ["credentialLifecycle"] },
      "then": { "properties": { "credentialLifecycle": { "properties": { "state": { "const": "active" }, "retireAfter": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "credentialLifecycle": { "properties": { "state": { "enum": ["none", "tombstoned"] } }, "required": ["state"] } }, "required": ["credentialLifecycle"] },
      "then": {
        "properties": {
          "credentialLifecycle": {
            "properties": {
              "pendingOperation": { "type": "null" },
              "retireAfter": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "verification": { "properties": { "status": { "const": "passed" } }, "required": ["status"] } }, "required": ["verification"] },
      "then": { "properties": { "verification": { "properties": { "testedAt": { "type": "string" }, "identityDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "errorCode": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "verification": { "properties": { "status": { "const": "not_run" } }, "required": ["status"] } }, "required": ["verification"] },
      "then": { "properties": { "verification": { "properties": { "testedAt": { "type": "null" }, "identityDigest": { "type": "null" }, "errorCode": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "verification": { "properties": { "status": { "const": "failed" } }, "required": ["status"] } }, "required": ["verification"] },
      "then": { "properties": { "verification": { "properties": { "testedAt": { "type": "string" }, "identityDigest": { "type": "null" }, "errorCode": { "type": "string", "minLength": 1 } } } } }
    }
  ],
  "$defs": {
    "activeLease": {
      "type": "object", "additionalProperties": false,
      "required": ["leaseId", "jobId", "purpose", "credentialRevision", "bindingDigest", "acquiredRevision", "acquiredAt"],
      "properties": {
        "leaseId": { "type": "string", "pattern": "^lease_[a-z0-9]{16,64}$" },
        "jobId": { "type": "string", "pattern": "^job_[a-z0-9]{16,64}$" },
        "purpose": { "enum": ["diagnosis", "verification"] },
        "credentialRevision": { "type": ["integer", "null"], "minimum": 1 },
        "bindingDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "acquiredRevision": { "type": "integer", "minimum": 1 },
        "acquiredAt": { "type": "string", "format": "date-time" }
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "role", "id", "displayName"],
      "properties": {
        "kind": { "enum": ["system", "user"] },
        "role": { "enum": ["system", "owner"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "user" } }, "required": ["kind"] },
          "then": { "properties": { "role": { "const": "owner" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "system" } }, "required": ["kind"] },
          "then": { "properties": { "role": { "const": "system" } } }
        }
      ]
    },
    "sourceTransitionEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "sourceRevision", "type", "operation", "fromState", "toState", "credentialRevision", "actor", "createdAt", "reason"],
      "properties": {
        "eventId": { "type": "string", "pattern": "^sevt_[a-z0-9]{16,64}$" },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "type": { "const": "source_state" },
        "operation": { "enum": ["registered", "verified", "enabled", "edited", "leases_updated", "rotation_started", "rotation_completed", "disable_started", "disabled", "delete_started", "leases_drained", "tombstoned", "verification_failure_started", "verification_failed"] },
        "fromState": { "enum": [null, "draft", "enabled", "disabled", "draining", "verification_failed", "tombstoned"] },
        "toState": { "enum": ["draft", "enabled", "disabled", "draining", "verification_failed", "tombstoned"] },
        "credentialRevision": { "type": ["integer", "null"], "minimum": 1 },
        "actor": { "$ref": "#/$defs/actor" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "ownerApproval": {
      "type": "object", "additionalProperties": false,
      "required": ["approvedBy", "approvedAt", "reason"],
      "properties": {
        "approvedBy": {
          "allOf": [
            { "$ref": "#/$defs/actor" },
            { "properties": { "kind": { "const": "user" } } }
          ]
        },
        "approvedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "leaseEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "sourceRevision", "operation", "leaseId", "jobId", "purpose", "credentialRevision", "bindingDigest", "fromLeaseCount", "toLeaseCount", "actor", "ownerApproval", "createdAt", "reason"],
      "properties": {
        "eventId": { "type": "string", "pattern": "^levt_[a-z0-9]{16,64}$" },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "operation": { "enum": ["lease_acquired", "lease_released", "lease_force_cancelled"] },
        "leaseId": { "type": "string", "pattern": "^lease_[a-z0-9]{16,64}$" },
        "jobId": { "type": "string", "pattern": "^job_[a-z0-9]{16,64}$" },
        "purpose": { "enum": ["diagnosis", "verification"] },
        "credentialRevision": { "type": ["integer", "null"], "minimum": 1 },
        "bindingDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "fromLeaseCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "toLeaseCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "actor": { "$ref": "#/$defs/actor" },
        "ownerApproval": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ownerApproval" }
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "lease_acquired" } }, "required": ["operation"] },
          "then": { "properties": { "ownerApproval": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "lease_released" } }, "required": ["operation"] },
          "then": { "properties": { "ownerApproval": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "lease_force_cancelled" } }, "required": ["operation"] },
          "then": { "properties": { "ownerApproval": { "$ref": "#/$defs/ownerApproval" } } }
        }
      ]
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "required", "detail"],
      "properties": {
        "name": { "enum": ["version", "schema", "statement_summary", "slow_query", "statistics", "ordinary_explain", "prom_query", "alert_read"] },
        "status": { "enum": ["available", "denied", "missing", "unknown"] },
        "required": { "type": "boolean" },
