{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqllens.local/contracts/v4-diagnosis-input.schema.json",
  "title": "SQLLens v4 Diagnosis Input Evidence",
  "description": "统一诊断入口的冻结输入结构（#t27 Plan Replayer 解析与 #t25 诊断内核的汇合契约）。所有字段均为只读证据，数字为整数/安全浮点，禁止 NaN/Infinity。",
  "type": "object",
  "required": ["schema_version", "sql", "runtime", "plan", "stats", "schema"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "evidence/v3" },
    "ai_config": {
      "type": "object",
      "description": "可选 AI 增强配置：存在时诊断在规则报告之上追加 AI 三输出（单次调用）；仅会话内存，不落盘。",
      "additionalProperties": false,
      "properties": {
        "base_url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "api_key": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "protocol": { "enum": ["openai", "anthropic"], "default": "openai" }
      },
      "required": ["base_url", "api_key", "model"]
    },
    "sql": {
      "type": "object",
      "required": ["sql_digest", "database"],
      "additionalProperties": false,
      "properties": {
        "sql_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sql_text": { "type": "string", "maxLength": 65536 },
        "database": { "type": "string", "minLength": 1, "maxLength": 128 },
        "table_name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["exec_count", "window_minutes"],
      "additionalProperties": false,
      "properties": {
        "exec_count": { "type": "integer", "minimum": 0 },
        "window_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "avg_total_keys": { "type": "integer", "minimum": 0 },
        "scanned_rows": { "type": "integer", "minimum": 0 },
        "result_rows": { "type": "integer", "minimum": 0 },
        "weighted_total_keys": { "type": "integer", "minimum": 0 }
      }
    },
    "plan": {
      "type": "object",
      "required": ["operator_rows"],
      "additionalProperties": false,
      "properties": {
        "operator_rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["operator", "table"],
            "additionalProperties": false,
            "properties": {
              "operator": { "type": "string", "minLength": 1, "maxLength": 64 },
              "table": { "type": "string", "minLength": 1, "maxLength": 128 },
              "est_rows": { "type": "integer", "minimum": 0 },
              "access_path": { "type": "string", "maxLength": 256 }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "est_rows": { "type": "integer", "minimum": 0 },
        "actual_rows": { "type": "integer", "minimum": 0 },
        "healthy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "row_count": { "type": "integer", "minimum": 0 },
        "last_analyze_at": { "type": "string", "format": "date-time" }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filter_columns": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "indexes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["name", "columns"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            }
          }
        }
      }
    },
    "optional": {
      "type": "object",
      "description": "可选上下文：批量任务基线（分钟）、目标值、调用削减 A/B 实测。",
      "additionalProperties": false,
      "properties": {
        "batch_before_min": { "type": "number", "minimum": 0 },
        "batch_target_min": { "type": "number", "minimum": 0 },
        "baseline_weighted_keys": { "type": "integer", "minimum": 0 },
        "reduced_weighted_keys": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
