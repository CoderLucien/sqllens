{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sqllens/contracts/diagnosis-report-v1.schema.json",
  "title": "DiagnosisReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "caseRevision",
    "audience",
    "titleZh",
    "priority",
    "configuredMode",
    "effectiveMode",
    "conclusionZh",
    "impact",
    "evidenceSummary",
    "reasoning",
    "actions",
    "uncertainty",
    "trace"
  ],
  "properties": {
    "schemaVersion": { "const": "diagnosis-report/v1" },
    "caseId": { "type": "string", "pattern": "^case_[a-z0-9]{16,64}$" },
    "caseRevision": { "type": "integer", "minimum": 1 },
    "audience": { "enum": ["dba_sre", "developer", "incident_owner"] },
    "titleZh": { "type": "string", "minLength": 1, "maxLength": 256 },
    "priority": { "enum": ["P0", "P1", "P2", "P3", "observe"] },
    "configuredMode": { "enum": ["rules", "rules_ai"] },
    "effectiveMode": { "enum": ["rules", "rules_ai"] },
    "conclusionZh": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterZh", "databaseZh", "sqlDigest", "timeWindowZh", "businessZh"],
      "properties": {
        "clusterZh": { "type": "string", "minLength": 1, "maxLength": 256 },
        "databaseZh": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sqlDigest": { "type": "string", "minLength": 1, "maxLength": 256 },
        "timeWindowZh": { "type": "string", "minLength": 1, "maxLength": 256 },
        "businessZh": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "evidenceSummary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["labelZh", "valueZh", "evidenceIds"],
        "properties": {
          "labelZh": { "type": "string", "minLength": 1, "maxLength": 128 },
          "valueZh": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" }
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleFindingsZh", "aiContributionZh", "degradationZh"],
      "properties": {
        "ruleFindingsZh": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "aiContributionZh": { "type": ["string", "null"], "maxLength": 2048 },
        "degradationZh": { "type": ["string", "null"], "maxLength": 2048 }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "order",
          "titleZh",
          "ownerZh",
          "riskZh",
          "stepsZh",
          "validationZh",
          "rollbackZh"
        ],
        "properties": {
          "actionId": { "type": "string", "pattern": "^act_[a-z0-9]{16,64}$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 3 },
          "titleZh": { "type": "string", "minLength": 1, "maxLength": 256 },
          "ownerZh": { "type": "string", "minLength": 1, "maxLength": 128 },
          "riskZh": { "type": "string", "minLength": 1, "maxLength": 512 },
          "stepsZh": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
          },
          "validationZh": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "rollbackZh": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceLevel",
        "evidenceIds",
        "ruleIds",
        "claimIds",
        "sourceRevisions",
        "pinnedRevisions"
      ],
      "properties": {
        "evidenceLevel": { "enum": ["E0", "E1", "E2", "E3", "E4"] },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 512,
          "items": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" }
        },
        "ruleIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" }
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^claim_[a-z0-9]{16,64}$" }
        },
        "sourceRevisions": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^src_[a-z0-9]{16,64}@[1-9][0-9]*$" }
        },
        "pinnedRevisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
